# Copy to .env and adjust. .env is gitignored; .env.example is committed.
# This split is the standard pattern for "documented config, secret values"
# even when nothing here is actually secret — it lowers the cognitive
# cost of finding "what knobs does this project have."

# Ollama HTTP endpoint. Default is the local install on the same machine.
# If you ever run Ollama on a separate box (e.g., a GPU server), point this
# at its IP. The whole pipeline only talks to Ollama through this URL.
OLLAMA_HOST=http://localhost:11434

# Models. Pinned here so you change them in one place.
# qwen3:14b is the primary LLM (best multi-domain reasoning at 14B).
# nomic-embed-text is the embedding model (fast, multilingual, 768-dim).
ONCLAB_LLM_MODEL=qwen3:14b
ONCLAB_EMBED_MODEL=nomic-embed-text

# Set to 1 to bypass Ollama and use canned mock responses.
# This is the toggle that lets unit tests run without `ollama serve` up.
# Keep it 0 in normal use; CI flips it to 1 for the smoke-eval pass.
MOCK_LLM=0

# Phoenix project name. Shows up as the workspace name in the UI at :6006.
# Useful when you have multiple labs running through the same Phoenix instance.
PHOENIX_PROJECT_NAME=oncology-rag-lab
